# API Keys para o Roteiro a Dois
# Copie este arquivo para .env.local e preencha os valores

# TMDB - Filmes e Séries
# Pegue em https://www.themoviedb.org/settings/api
# Use a "API Key (v3)" OU o "API Read Access Token (v4)" — ambos funcionam.
TMDB_API_KEY=

# Geoapify - Restaurantes e mapas (fallback quando Google Places não está configurado)
# https://myprojects.geoapify.com
GEOAPIFY_API_KEY=

# Google Places (opcional, mas melhora MUITO fotos de restaurantes)
# Passo a passo:
# 1. https://console.cloud.google.com/ → criar/selecionar projeto
# 2. Ativar faturamento (há crédito grátis mensal)
# 3. APIs & Services → Library → buscar "Places API (New)" → Enable
# 4. APIs & Services → Credentials → Create credentials → API key
# 5. Restrinja a chave só para "Places API (New)"
# Cole a API key aqui (não é OAuth, é só a chave):
GOOGLE_PLACES_API_KEY=

# Ticketmaster - Eventos e Shows (https://developer.ticketmaster.com)
TICKETMASTER_API_KEY=

# Sympla - API oficial (Minha Conta → Integrações → Criar chave de acesso)
# https://developers.sympla.com.br/api-doc/
# Retorna eventos do organizador vinculado ao token; filtramos por SP por padrão.
SYMPLA_API_TOKEN=
SYMPLA_CITY=São Paulo
SYMPLA_STATE=SP

# OpenWeatherMap - Clima (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# OMDb - Enriquecimento opcional de notas (https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=

# TheMealDB - NÃO PRECISA DE KEY (usa key de teste '1' automaticamente)

# Backend full stack - opcional no deploy inicial
NEXT_PUBLIC_LIFE_API_URL=

# Supabase Data Hub (opcional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
